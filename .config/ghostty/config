config-file = ?"~/.config/theme/current/ghostty.conf"
# ── Shell (login shell is bash; force zsh for starship prompt) ──
command = /usr/bin/zsh
# ── Font ──────────────────────────────────────────────────────
font-family = "FiraCode Nerd Font Mono"
font-style = Medium
font-size = 13
font-feature = liga
# ── Window ────────────────────────────────────────────────────
window-theme = ghostty
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = raised
gtk-single-instance = detect
window-save-state = always
quit-after-last-window-closed = false
# ── Scrollback ────────────────────────────────────────────────
scrollback-limit = 10000
# ── Cursor ────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true
# Readability under transparency (background-opacity 0.40)
minimum-contrast = 0.4
bold-is-bright = true
font-thicken = true
# Kitty-parity: jump to tab, zoom font
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
# Ghostty zoom actions need an explicit amount (:1); the bare action name is rejected.
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
# ── Shell integration ─────────────────────────────────────────
shell-integration-features = no-cursor,ssh-env
# ── Opacity & focus ───────────────────────────────────────────
background-opacity = 0.40
unfocused-split-opacity = 0.4
# ── Mouse ─────────────────────────────────────────────────────
mouse-scroll-multiplier = 0.95
mouse-hide-while-typing = true
# ── Selection & clipboard ─────────────────────────────────────
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
# ── Links ─────────────────────────────────────────────────────
link-url = true
# ── Keybinds ──────────────────────────────────────────────────
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
# Split resizing
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
# Split navigation
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:top
keybind = ctrl+alt+down=goto_split:bottom
# New splits
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+z=toggle_split_zoom
# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+w=close_surface
# Reload config live
keybind = ctrl+shift+comma=reload_config
# Jump between prompts
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1
# Quick terminal dropdown (new in 1.2, Linux-supported now)
keybind = ctrl+grave_accent=toggle_quick_terminal
# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
