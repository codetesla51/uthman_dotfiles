#!/bin/bash
# record — toggle screen recording (gpu-screen-recorder preferred, wf-recorder fallback)
if pgrep -f "gpu-screen-recorder -w" >/dev/null || pgrep -x wf-recorder >/dev/null; then
  pkill -f "gpu-screen-recorder -w" 2>/dev/null
  pkill -x wf-recorder 2>/dev/null
  notify-send -u normal 'Recording stopped' 'Saved to ~/Videos/Recordings' 2>/dev/null
  exit 0
fi
DIR=~/Videos/Recordings
mkdir -p "$DIR"
FILE="$DIR/rec-$(date +%Y%m%d-%H%M%S).mp4"
if command -v gpu-screen-recorder >/dev/null; then
  # -ac aac: opus (the default) in .mp4 is rejected by Twitter/Instagram/WhatsApp upload pipelines
  setsid gpu-screen-recorder -w eDP-1 -a default_output -ac aac -o "$FILE" >/dev/null 2>&1 < /dev/null &
  notify-send -u normal 'Recording started' 'SUPER+R again to stop' 2>/dev/null
elif command -v wf-recorder >/dev/null; then
  setsid wf-recorder -f "$FILE" >/dev/null 2>&1 < /dev/null &
fi
