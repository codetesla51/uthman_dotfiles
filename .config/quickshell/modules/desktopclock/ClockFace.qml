import QtQuick
import QtQuick.Effects

// ClockFace — inline or stacked HH/mm, frosted with the wallpaper.
//
// The glass is three passes, bottom to top:
//   1. a rim: eight offset copies of the glyphs in the theme primary
//   2. the frost: the pre-blurred wallpaper masked to the glyph shape,
//      tinted toward the theme primary
//   3. a 1px inner edge to keep the letters crisp
// No runtime blur — the blur image is generated by scripts/wallcut.sh.
// Everything is static; it repaints only when the minute changes.
Item {
    id: root

    property color primary: "#9bd0d2"
    property color secondary: "#b6cacb"
    property color tertiary: "#f8b89b"
    property color foreground: "#e1e3e2"
    property color background: "#111414"
    property color outline: "#8f9898"

    property string hh: "00"
    property string mm: "00"
    property string dow: ""
    property string rest: ""

    property string layout: "row"        // "row" | "stack"
    property real shiftX: 0              // normalized offset from center
    property real shiftY: 0
    property real tilt: 0                // small lean around the subject
    property real tiltPivotX: 0
    property real tiltPivotY: 0
    property string blurSource: ""
    property bool frost: false
    // 0 = crisp, 1 = fully soft — used by the desktop-clock reveal
    property real focusBlur: 0

    // Bigger row type; the stacked fallback stays inside the safe area.
    readonly property real rowFs: height * 0.50
    readonly property real stackFs: height * 0.46
    readonly property real fs: layout === "stack" ? stackFs : rowFs
    readonly property rect glyphRect: maskGlyphs.textRect
    readonly property size rowTextSize: Qt.size(rowMeasure.textRect.width, rowMeasure.textRect.height)
    readonly property size stackTextSize: Qt.size(stackMeasure.textRect.width, stackMeasure.textRect.height)
    readonly property real rim: Math.max(2, height * 0.0024)

    // blend two theme colors, keeping the hue but borrowing luminance
    function mixColor(a, b, t, alpha) {
        return Qt.rgba(a.r + (b.r - a.r) * t,
                       a.g + (b.g - a.g) * t,
                       a.b + (b.b - a.b) * t,
                       alpha)
    }

    component Glyphs: Item {
        id: g

        property string hh: "00"
        property string mm: "00"
        property bool stacked: false
        property real fs: 100
        property real shiftX: 0
        property real shiftY: 0
        property color fill: "white"
        property color stroke: "transparent"
        property bool outlined: false

        readonly property rect textRect: stacked
            ? Qt.rect(col.x, col.y, col.width, col.height)
            : Qt.rect(row.x, row.y, row.width, row.height)

        Text {
            id: row
            visible: !g.stacked
            text: g.hh + ":" + g.mm
            x: (g.width - width) / 2 + g.width * g.shiftX
            y: (g.height - height) / 2 + g.height * g.shiftY
            font.family: "Iceberg"
            font.pixelSize: g.fs
            color: g.fill
            style: g.outlined ? Text.Outline : Text.Normal
            styleColor: g.stroke
        }

        Column {
            id: col
            visible: g.stacked
            x: (g.width - width) / 2 + g.width * g.shiftX
            y: (g.height - height) / 2 + g.height * g.shiftY
            spacing: 0

            Text {
                text: g.hh
                height: g.fs * 0.88
                font.family: "Iceberg"
                font.pixelSize: g.fs
                lineHeight: g.fs * 0.88
                lineHeightMode: Text.FixedHeight
                color: g.fill
                style: g.outlined ? Text.Outline : Text.Normal
                styleColor: g.stroke
            }
            Text {
                text: g.mm
                height: g.fs * 0.88
                font.family: "Iceberg"
                font.pixelSize: g.fs
                lineHeight: g.fs * 0.88
                lineHeightMode: Text.FixedHeight
                color: g.fill
                style: g.outlined ? Text.Outline : Text.Normal
                styleColor: g.stroke
            }
        }
    }

    // Off-screen measurers: auto layout needs both boxes before choosing.
    Glyphs {
        id: rowMeasure
        anchors.fill: parent
        hh: root.hh
        mm: root.mm
        stacked: false
        fs: root.rowFs
        fill: "white"
        visible: false
    }
    Glyphs {
        id: stackMeasure
        anchors.fill: parent
        hh: root.hh
        mm: root.mm
        stacked: true
        fs: root.stackFs
        fill: "white"
        visible: false
    }

    // ---- the whole face in one layer, so the shadow sits under all of it ----
    Item {
        id: face
        anchors.fill: parent

        // Lean the whole face around the point where the subject crosses it.
        // The mask, frost, rim and shadow all ride this one transform.
        transform: Rotation {
            origin.x: root.tiltPivotX
            origin.y: root.tiltPivotY
            angle: root.tilt
            Behavior on angle {
                NumberAnimation { duration: 520; easing.type: Easing.OutCubic }
            }
        }

        // rim: offset copies give the stroke a width Qt's Text.Outline lacks
        Repeater {
            model: 8
            delegate: Glyphs {
                anchors.fill: parent
                hh: root.hh
                mm: root.mm
                stacked: root.layout === "stack"
                shiftX: root.shiftX
                shiftY: root.shiftY
                fs: root.fs
                fill: Qt.rgba(root.primary.r, root.primary.g, root.primary.b, 0.9)
                visible: root.frost
                transform: Translate {
                    x: Math.cos(index * Math.PI / 4) * root.rim
                    y: Math.sin(index * Math.PI / 4) * root.rim
                }
            }
        }

        // ---- the glass itself: blur + theme tint + sheen, masked in one pass ----
        Item {
            id: glassSrc
            anchors.fill: parent
            visible: false

            Image {
                id: blurImg
                anchors.fill: parent
                fillMode: Image.PreserveAspectCrop
                asynchronous: true
                cache: false
                source: root.blurSource
            }

            // theme tint — mixed toward foreground so the glass keeps luminance
            Rectangle {
                anchors.fill: parent
                gradient: Gradient {
                    GradientStop { position: 0.00; color: root.mixColor(root.primary, root.foreground, 0.55, 0.74) }
                    GradientStop { position: 0.55; color: root.mixColor(root.secondary, root.foreground, 0.30, 0.30) }
                    GradientStop { position: 1.00; color: root.mixColor(root.primary, root.foreground, 0.10, 0.52) }
                }
            }

            // the sweet sheen: a tilted highlight across the top, faint reflection at the bottom
            Item {
                anchors.fill: parent
                clip: true

                Rectangle {
                    width: parent.width * 1.4
                    height: parent.height
                    x: -parent.width * 0.2
                    y: 0
                    rotation: -8
                    transformOrigin: Item.Center
                    gradient: Gradient {
                        GradientStop { position: 0.00; color: Qt.rgba(root.foreground.r, root.foreground.g, root.foreground.b, 0.78) }
                        GradientStop { position: 0.18; color: Qt.rgba(root.foreground.r, root.foreground.g, root.foreground.b, 0.24) }
                        GradientStop { position: 0.42; color: Qt.rgba(root.foreground.r, root.foreground.g, root.foreground.b, 0.02) }
                        GradientStop { position: 0.80; color: Qt.rgba(root.foreground.r, root.foreground.g, root.foreground.b, 0.00) }
                        GradientStop { position: 1.00; color: Qt.rgba(root.foreground.r, root.foreground.g, root.foreground.b, 0.18) }
                    }
                }
            }
        }

        MultiEffect {
            anchors.fill: parent
            source: glassSrc
            maskEnabled: true
            maskSource: maskGlyphs
            visible: root.frost && blurImg.status === Image.Ready
        }

        // glyph alpha only — the mask, not something the eye sees
        Glyphs {
            id: maskGlyphs
            anchors.fill: parent
            hh: root.hh
            mm: root.mm
            stacked: root.layout === "stack"
            shiftX: root.shiftX
            shiftY: root.shiftY
            fs: root.fs
            fill: "white"
            visible: false
            layer.enabled: true
        }

        // fallback fill when there is no blur asset yet, plus the 1px inner edge
        Glyphs {
            id: visibleGlyphs
            anchors.fill: parent
            hh: root.hh
            mm: root.mm
            stacked: root.layout === "stack"
            shiftX: root.shiftX
            shiftY: root.shiftY
            fs: root.fs
            fill: (root.frost && blurImg.status === Image.Ready)
                  ? "transparent"
                  : Qt.rgba(root.primary.r, root.primary.g, root.primary.b, 0.22)
            stroke: Qt.rgba(root.primary.r, root.primary.g, root.primary.b, 0.95)
            outlined: true
        }

        layer.enabled: true
        layer.effect: MultiEffect {
            blurEnabled: root.focusBlur > 0.001
            blurMax: 40
            blur: root.focusBlur
            shadowEnabled: true
            shadowBlur: 0.8
            shadowVerticalOffset: root.height * 0.012
            shadowColor: Qt.rgba(root.background.r, root.background.g, root.background.b, 0.55)
        }
    }
}
