#!/bin/bash
# touchpad [on|off|toggle] — enable/disable the laptop touchpad via hyprctl
export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t /run/user/1000/hypr/ 2>/dev/null | head -1)
DEV=$(hyprctl devices -j 2>/dev/null | python3 -c "import json,sys,re; d=json.load(sys.stdin); print(next((m['name'] for m in d.get('mice',[]) if re.search('touchpad|trackpad', m.get('name',''), re.I)), ''))")
[[ -z "$DEV" ]] && exit 1
set_state() { hyprctl keyword "device:$DEV:enabled" "$1" >/dev/null; }
case "${1:-toggle}" in
  on) set_state true ;;
  off) set_state false ;;
  *)
    CUR=$(hyprctl getoption "device:$DEV:enabled" 2>/dev/null | awk '/int:/{print $2}')
    [[ "$CUR" == "1" ]] && set_state false || set_state true ;;
esac
