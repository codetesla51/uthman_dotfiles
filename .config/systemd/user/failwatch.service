[Unit]
Description=FailWatch silent-failure watcher (failed units + journal errors)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/dotfiles/.config/quickshell/scripts/failwatch-daemon.py
Restart=on-failure
RestartSec=10
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
