* {
    background:  #{{ colors.surface.default.hex_stripped }}ee;
    selected:    #{{ colors.surface_variant.default.hex_stripped }}26;
    accent:      #{{ colors.primary.default.hex_stripped }};
    border-col:  #{{ colors.outline.default.hex_stripped }}1a;
    text:        #{{ colors.on_surface.default.hex_stripped }};
    placeholder: #{{ colors.on_surface.default.hex_stripped }}33;
}
