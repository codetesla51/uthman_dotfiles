#!/usr/bin/env bash
# Fullscreen Quickshell takeover overlay. The real desktop stays visible
# underneath; Hyprland's screen shader adds a temporary glitch pass.
#
#   hacked       show it (auto-closes after 30s)
#   hacked off   stop it now and restore the screen shader
set -euo pipefail

CONFIG="$HOME/.config/quickshell/hacked"
SHADER="$CONFIG/glitch.frag"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNTIME/hacked-qs.pid"
LOG="$RUNTIME/hacked-qs.log"

hypr_set_shader() {
  local path="$1"
  command -v hyprctl >/dev/null 2>&1 || return 0
  # Hyprland 0.56 uses the Lua config engine; `hyprctl keyword` is rejected
  # by the non-legacy parser, so apply the runtime value through eval.
  hyprctl eval "hl.config({ decoration = { screen_shader = \"$path\" } })" >/dev/null 2>&1 || true
}

stop_overlay() {
  local pid=""
  [[ -f "$PIDFILE" ]] && read -r pid < "$PIDFILE" || true
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
}

if [[ "${1:-}" == "off" ]]; then
  stop_overlay
  hypr_set_shader ""
  exit 0
fi

# If an overlay is already alive, do not start a second one.
if [[ -f "$PIDFILE" ]]; then
  old_pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
  rm -f "$PIDFILE"
fi

# Preserve an existing user shader if there is one, then apply the glitch.
ORIG_SHADER=""
if command -v hyprctl >/dev/null 2>&1; then
  ORIG_SHADER="$(hyprctl getoption decoration:screen_shader -j 2>/dev/null | jq -r '.str // ""' 2>/dev/null || true)"
  [[ "$ORIG_SHADER" == "[[EMPTY]]" ]] && ORIG_SHADER=""
fi

cleanup() {
  stop_overlay
  hypr_set_shader "$ORIG_SHADER"
}
trap cleanup EXIT INT TERM

if [[ "${HACKED_NO_SHADER:-0}" != "1" && -f "$SHADER" ]]; then
  hypr_set_shader "$SHADER"
fi

quickshell -p "$CONFIG" >"$LOG" 2>&1 &
QS_PID=$!
printf '%s\n' "$QS_PID" >"$PIDFILE"

# Stay up until explicitly released with `hacked off` (or SUPER+SHIFT+ESC).
wait "$QS_PID" 2>/dev/null || true
