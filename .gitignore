# pip console scripts + uv-managed pythons — regenerated by `pip install`, never commit
.local/bin/pip
.local/bin/pip3
.local/bin/pip3.*
.local/bin/fonttools
.local/bin/pyftmerge
.local/bin/pyftsubset
.local/bin/ttx
.local/bin/python3.*

# app-managed symlink into the local zed.app bundle
.local/bin/zed
# downloaded AppImages — 100MB+ binaries, not source
.local/opt/*.AppImage
# matugen-generated outputs — regenerated on every wallpaper apply, never commit
.config/cava/config
.config/quickshell/colors.css
.config/rofi/colors.rasi
.config/zathura/zathurarc
.config/zed/settings.json
.config/zed/themes/matugen.json
