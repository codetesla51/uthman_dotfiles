#!/usr/bin/env bash
# privacy-screen — blur and dim the whole display without locking.
# Toggle with SUPER+ALT+X. The shader is removed on the second press.
set -euo pipefail

shader="$HOME/.config/hypr/shaders/privacy.glsl"
current=$(hyprctl getoption decoration:screen_shader)

# Hyprland 0.56 uses the Lua parser for this option, so `keyword` is rejected.
if [[ "$current" == *"privacy.glsl"* ]]; then
    hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null
    hyprctl notify 5 1000 0 "Privacy screen off"
else
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null
    hyprctl notify 5 1000 0 "Privacy screen on"
fi
