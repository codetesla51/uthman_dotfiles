[general]
# fit bars to the terminal automatically from width/spacing
bar_width = 4
bar_spacing = 2
framerate = 120
sensitivity = 100
autosens = 1
overshoot = 20
# focus on the musical range, skip rumble and hiss
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[color]
background = "#151311"
gradient = 1
gradient_count = 8
gradient_color_1 = "#fff8ed"
gradient_color_2 = "#fff8ed"
gradient_color_3 = "#cfc6b3"
gradient_color_4 = "#cfc6b3"
gradient_color_5 = "#fcf7ff"
gradient_color_6 = "#fcf7ff"
gradient_color_7 = "#9c9689"
gradient_color_8 = "#4b463c"

[smoothing]
# the rice: clean jitter-free bars with the classic monstercat shoulder
noise_reduction = 62
monstercat = 1.4
waves = 0
gravity = 80
