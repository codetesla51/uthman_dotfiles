[general]
# fit bars to the terminal automatically from width/spacing
bar_width = 4
bar_spacing = 2
framerate = 120
sensitivity = 100
autosens = 1
overshoot = 20
# focus on the musical range, skip rumble and hiss
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[color]
background = "{{ colors.background.default.hex }}"
gradient = 1
gradient_count = 8
gradient_color_1 = "{{ colors.primary.default.hex }}"
gradient_color_2 = "{{ colors.primary.default.hex }}"
gradient_color_3 = "{{ colors.secondary.default.hex }}"
gradient_color_4 = "{{ colors.secondary.default.hex }}"
gradient_color_5 = "{{ colors.tertiary.default.hex }}"
gradient_color_6 = "{{ colors.tertiary.default.hex }}"
gradient_color_7 = "{{ colors.outline.default.hex }}"
gradient_color_8 = "{{ colors.surface_variant.default.hex }}"

[smoothing]
# the rice: clean jitter-free bars with the classic monstercat shoulder
noise_reduction = 62
monstercat = 1.4
waves = 0
gravity = 80
