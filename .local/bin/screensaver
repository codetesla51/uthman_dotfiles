#!/bin/bash
EFFECT_MODE="random"
if [[ "$1" == "--effect" && -n "$2" ]]; then
  [[ "$2" == "decrypt" ]] && EFFECT_MODE="decrypt"
elif [[ "$*" == *"decrypt"* ]]; then
  EFFECT_MODE="decrypt"
fi
screensaver_in_focus() {
  hyprctl activewindow -j 2>/dev/null | jq -e '.class == "org.screensaver"' >/dev/null 2>&1
}
exit_screensaver() {
  hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x tte 2>/dev/null || true
  pkill -f org.screensaver 2>/dev/null || true
  exit 0
}
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT
printf '\033]11;rgb:00/00/00\007'
hyprctl keyword cursor:invisible true &>/dev/null || true
tty=$(tty 2>/dev/null)
BRAND_FILE="$HOME/.config/branding"
[ -f "$BRAND_FILE" ] || BRAND_FILE="$HOME/.config/branding/screensaver.txt"
[ -f "$BRAND_FILE" ] || BRAND_FILE="$HOME/.config/branding.txt"
[ -f "$BRAND_FILE" ] || echo "BRANDING" > "$HOME/.config/branding"
if [ "$EFFECT_MODE" = "decrypt" ]; then
  CMD=(tte -i "$BRAND_FILE" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor decrypt)
else
  CMD=(tte -i "$BRAND_FILE" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor)
fi
while true; do
  "${CMD[@]}" &
  while pgrep -t "${tty#/dev/}" -x tte >/dev/null 2>&1; do
    if read -n1 -t 1 2>/dev/null || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
  sleep 0.1
done
