set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#580003"
set notification-warning-bg     "#f2bc8e"
set notification-warning-fg     "#3f2001"
set notification-bg             "#121415"
set notification-fg             "#e6e7e8"

set completion-bg               "#212324"
set completion-fg               "#e6e7e8"
set completion-group-bg         "#212324"
set completion-group-fg         "#b9c9d2"
set completion-highlight-bg     "#a2cde2"
set completion-highlight-fg     "#002c3b"

set index-bg                    "#121415"
set index-fg                    "#e6e7e8"
set index-active-bg             "#406a7d"
set index-active-fg             "#ffffff"

set inputbar-bg                 "#212324"
set inputbar-fg                 "#e6e7e8"
set statusbar-bg                "#212324"
set statusbar-fg                "#e6e7e8"

set highlight-color             "#a2cde2"
set highlight-active-color      "#b9c9d2"
set default-bg                  "#121415"
set default-fg                  "#e6e7e8"
set recolor-lightcolor          "#121415"
set recolor-darkcolor           "#e6e7e8"

set render-loading              true
set recolor                     true
set recolor-keephue             true
set adjust-open                 width
set scroll-page-aware           true
set selection-clipboard         clipboard

# rice: basename in statusbar (z-library paths are endless), % position,
# comfortable padding + terminal-matched font
set font                        "FiraCode Nerd Font 10"
set statusbar-basename          true
set statusbar-page-percent      true
set statusbar-h-padding         10
set statusbar-v-padding         6
set page-padding                12
set scroll-step                 60
set zoom-min                    20
set zoom-max                    500

# n/N flip pages (search-match nav moves to t/T)
map n navigate next
map N navigate previous
map t search next
map T search previous
