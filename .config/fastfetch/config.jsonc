{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/uthman/fastfetchImages/95771929570969777-removebg-preview.png",
    "width": 24,
    "height": 16,
    "padding": { "top": 1, "right": 2, "left": 1 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 16 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#cyan}{user-name}{#default}@{#blue}{host-name}{#default}" },
    "break",
    { "type": "os", "key": "│ 󰣇 System", "keyColor": "blue", "format": "{name}" },
    { "type": "kernel", "key": "│ 󰻿 Kernel", "keyColor": "blue", "format": "{release}" },
    { "type": "uptime", "key": "│ 󰅐 Uptime", "keyColor": "blue", "format": "{days}d {hours}h {minutes}m" },
    { "type": "packages", "key": "│ 󰏗 Apps", "keyColor": "blue", "format": "{all}" },
    { "type": "wm", "key": "│ 󰕮 Desktop", "keyColor": "magenta" },
    { "type": "shell", "key": "│ 󰆍 Shell", "keyColor": "magenta" },
    { "type": "terminal", "key": "│ 󰆟 Term", "keyColor": "magenta" },
    { "type": "cpu", "key": "│ 󰻠 CPU", "keyColor": "cyan", "format": "{name}" },
    { "type": "disk", "key": "│ 󰋊 Disk", "keyColor": "cyan", "format": "{size-used} / {size-total}" },
    { "type": "disk", "key": "│ 󰃰 OS Age", "keyColor": "cyan", "folders": "/", "format": "{days} days" },
    { "type": "battery", "key": "│ 󰁹 Battery", "keyColor": "cyan", "format": "{capacity}% {status}" },
    { "type": "custom", "key": " ", "format": "╰─" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
