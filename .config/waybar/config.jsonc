{
  "position": "top",
  "margin-top": 6,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  "fixed-center": true,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "custom/separator",
    "custom/now-playing",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/screenrecord",
    "custom/idle-indicator",
    "custom/notification-silencing-indicator",
    "custom/update",
    "tray",
    "memory",
    "custom/temperature",
    "cpu",
    "network",
    "battery",
    "custom/weather",
  ],

  // ─── Custom decorators ───
  "custom/arch": {
    "format": "\uf303",
    "tooltip": false,
  },
  "custom/separator": {
    "format": " ",
    "tooltip": false,
  },

  // ─── Screen Recording ───
  "custom/screenrecord": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec": "~/.config/waybar/scripts/screenrecord-status.sh",
    "on-click": "~/.local/bin/omarchy-capture-screenrecording",
    "on-click-right": "~/.local/bin/omarchy-capture-screenrecording --with-desktop-audio",
    "on-click-middle": "~/.local/bin/omarchy-capture-screenrecording --with-webcam",
    "tooltip": true,
  },

  // ─── Clock ───
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%A  ·  %d %B %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
  },

  // ─── Workspaces ───
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰮯",
      "default": "󰊠",
      "empty": "󰑊",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },

  // ─── Tray ───
  "custom/idle-indicator": {
    "on-click": "omarchy-toggle-idle",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/idle.sh",
    "signal": 9,
    "return-type": "json"
  },
  "custom/notification-silencing-indicator": {
    "on-click": "swaync-client -d",
    "exec": "~/.config/waybar/scripts/dnd.sh",
    "signal": 10,
    "return-type": "json"
  },
  "custom/update": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/update.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 7,
    "on-click": "omarchy-update",
    "tooltip": true,
  },
  "custom/temperature": {
    "exec": "~/.config/waybar/scripts/temperature.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 11,
    "tooltip": true,
  },
  "tray": {
    "icon-size": 13,
    "spacing": 8,
  },

  // ─── System ───
  "cpu": {
    "interval": 3,
    "format": "󰻠 {usage}%",
    "on-click": "xdg-terminal-exec btop",
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "xdg-terminal-exec btop",
  },

  // ─── Network ───
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "notify-send -u low \"$(omarchy-weather-status)\""
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰖪 Off",
    "tooltip-format-wifi": "  {essid}\n󰩟  {ipaddr}\n󰁞  {bandwidthUpBits}\n󰁆  {bandwidthDownBits}",
    "interval": 5,
    "on-click": "omarchy-launch-wifi",
  },

  // ─── Battery ───
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:.1f}W",
    "interval": 15,
    "states": {
      "warning": 30,
      "critical": 15,
    },
  },

  // ─── Media ───
  "custom/now-playing": {
    "exec": "~/.config/waybar/scripts/now-playing.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
  },
}
