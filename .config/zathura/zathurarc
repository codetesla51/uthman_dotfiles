set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#580003"
set notification-warning-bg     "#d8c2b7"
set notification-warning-fg     "#32251e"
set notification-bg             "#131314"
set notification-fg             "#e9e6e6"

set completion-bg               "#232323"
set completion-fg               "#e9e6e6"
set completion-group-bg         "#232323"
set completion-group-fg         "#c4c7c8"
set completion-highlight-bg     "#bfc8cc"
set completion-highlight-fg     "#20292c"

set index-bg                    "#131314"
set index-fg                    "#e9e6e6"
set index-active-bg             "#5d6669"
set index-active-fg             "#ffffff"

set inputbar-bg                 "#232323"
set inputbar-fg                 "#e9e6e6"
set statusbar-bg                "#232323"
set statusbar-fg                "#e9e6e6"

set highlight-color             "#bfc8cc"
set highlight-active-color      "#c4c7c8"
set default-bg                  "#131314"
set default-fg                  "#e9e6e6"
set recolor-lightcolor          "#131314"
set recolor-darkcolor           "#e9e6e6"

set render-loading              true
set recolor                     true
set recolor-keephue             true
set adjust-open                 width
set scroll-page-aware           true
set selection-clipboard         clipboard

# rice: basename in statusbar (z-library paths are endless), % position,
# comfortable padding + terminal-matched font
set font                        "FiraCode Nerd Font 10"
set statusbar-basename          true
set statusbar-page-percent      true
set statusbar-h-padding         10
set statusbar-v-padding         6
set page-padding                12
set scroll-step                 60
set zoom-min                    20
set zoom-max                    500

# n/N flip pages (search-match nav moves to t/T)
map n navigate next
map N navigate previous
map t search next
map T search previous
