/**
 * shortlist.rasi — airy list-style theme for short dmenu menus
 * (omarchy menu picker, SUPER+ESC power/session menu, and other
 * popups with only a few entries).
 * fixed-height: false so the container shrinks to fit the entries.
 * columns: 1, horizontal element orientation, generous spacing.
 */

* {
    background:     #111111ee;
    selected:       #ffffff14;
    accent:         #89b4fa;
    border-col:     #ffffff14;
    text:           #e8e8e8;
    placeholder:    #ffffff33;
}

window {
    width:            340px;
    background-color: @background;
    border:            1px;
    border-color:      @border-col;
    border-radius:     16px;
    padding:           14px;
}

mainbox {
    background-color: transparent;
    spacing:           10px;
    children:          [ inputbar, listview ];
}

inputbar {
    background-color: @selected;
    border-radius:      10px;
    border:              0px;
    padding:             9px 14px;
    spacing:             10px;
    children:            [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:        @accent;
    font:               "JetBrainsMono Nerd Font 11";
}

entry {
    background-color:  transparent;
    text-color:         @text;
    font:               "JetBrainsMono Nerd Font 11";
    placeholder-color:  @placeholder;
}

listview {
    background-color: transparent;
    border:              0px;
    spacing:             4px;
    columns:             1;
    fixed-height:        false;
    scrollbar:           false;
    cycle:               true;
}

element {
    background-color: transparent;
    orientation:         horizontal;
    border-radius:       10px;
    border:              1px;
    border-color:        transparent;
    padding:             9px 12px;
    spacing:             10px;
    children:            [ element-text ];
}

element selected {
    border-color:      @accent;
    background-color:  @selected;
}

element-text {
    background-color: transparent;
    text-color:         @text;
    font:               "JetBrainsMono Nerd Font 11";
    horizontal-align:    0.0;
    vertical-align:      0.5;
}

?import "colors.rasi"
