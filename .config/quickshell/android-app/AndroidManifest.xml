<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.uthman.phonelink">
    <application android:label="PhoneRelay">
        <!-- clip relay: launched by PhoneLink via `adb shell am start` -->
        <activity android:name=".PhoneRelayActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            />
        <!-- share-sheet target: forwards shared text/files into Download/PhoneLinkInbox -->
        <activity android:name=".ShareRelayActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
    </application>
</manifest>