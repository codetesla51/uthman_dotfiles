#!/bin/bash
# set-wallpaper [image] — crossfade a new wallpaper and regenerate the theme in one go.
# Falls back to a swaybg relaunch if awww/swww isn't installed.

IMAGE="${1:-$(readlink ~/.config/theme/current/background 2>/dev/null | tr -d '[:space:]')}"
[[ -z "$IMAGE" ]] && IMAGE="$(readlink ~/.config/omarchy/current/background 2>/dev/null | tr -d '[:space:]')"

if [[ -z "$IMAGE" ]]; then
    echo "Error: no wallpaper given and no current background" >&2
    exit 1
fi

if [[ ! -f "$IMAGE" ]]; then
    echo "Error: wallpaper not found at $IMAGE" >&2
    exit 1
fi

IMAGE="$(realpath "$IMAGE")"
mkdir -p ~/.config/theme/current ~/.config/omarchy/current
ln -sfn "$IMAGE" ~/.config/theme/current/background
ln -sfn "$IMAGE" ~/.config/omarchy/current/background  # legacy compat

# hyprlock can't animate: keep a flattened still beside the live background.
# GIFs donate their first frame; stills just get symlinked. Runs under wait.
STATIC="$HOME/.config/theme/current/background-static.jpg"
case "$IMAGE" in
    *.gif|*.GIF)
        # rm first: STATIC may be a symlink to a still — extracting through it
        # would overwrite that wallpaper file instead of replacing the link.
        { rm -f "$STATIC" && vipsthumbnail "$IMAGE" --size 1920 -o "$STATIC[Q=90,strip]" >/dev/null 2>&1 ||           WALL="$IMAGE" OUT="$STATIC" python3 -c "import os; from PIL import Image; Image.open(os.environ['WALL']).convert('RGB').save(os.environ['OUT'])"; } &
        ;;
    *) ln -sfn "$IMAGE" "$STATIC" ;;
esac

if command -v awww >/dev/null 2>&1; then
    WALL="awww"
    DAEMON="awww-daemon"
elif command -v swww >/dev/null 2>&1; then
    WALL="swww"
    DAEMON="swww-daemon"
fi

if [[ -n "$WALL" ]]; then
    if ! pgrep -x "$DAEMON" >/dev/null 2>&1; then
        setsid "$DAEMON" >/dev/null 2>&1 &
        sleep 0.3
    fi
    # Wavy wipe sweeping across the screen, 0.7s — fast with character.
    "$WALL" img "$IMAGE" --transition-type wave --transition-angle 45 --transition-duration 0.7 --transition-fps 60 &
else
    pkill -x swaybg 2>/dev/null
    sleep 0.2
    nohup swaybg -i "$IMAGE" -m fill >/dev/null 2>&1 &
    disown
fi

getTheme "$IMAGE" &
wait

# Nudge filemanager (watches theme.name) to hot-reload its matugen colors.
mkdir -p ~/.local/state/omarchy/current
basename "$IMAGE" > ~/.local/state/omarchy/current/theme.name
