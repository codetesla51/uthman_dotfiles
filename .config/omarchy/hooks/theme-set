#!/usr/bin/env bash
# theme-set hook: re-apply Papirus (full 44k icons) + nerd font after any omarchy theme change.
# omarchy stock themes default to "Yaru-black" icons, which is NOT installed.
# NOTE: Papirus is only ~4k icons and misses ghostty/firefox/btop etc.,
# so use full Papirus (FollowsColorScheme=true, adapts to dark rice).
# Hook receives the theme name as $1 (unused here).
gsettings set org.gnome.desktop.interface icon-theme 'Papirus' 2>/dev/null || true
gsettings set org.gnome.desktop.interface font-name 'FiraCode Nerd Font Mono 11' 2>/dev/null || true
exit 0
