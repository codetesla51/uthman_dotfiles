# Don't accidentally commit these
.env
# wallhaven api key for wallshelf — local secret
.config/quickshell/wallshelf.ini
*.secret
*.key
*.pem
# screenshot.png is now tracked intentionally
# quickshell session log — never commit
memory.md
.config/quickshell/memory.md
# local screenshots live in ~/Pictures (real dir, not stowed) — never commit
.config/quickshell/*Qt6QMLForBeginners*

# wallpapers live here but never get committed — no more pushing them
wallpapers/
__pycache__/
plan.md
# android relay build artifacts (keystore + apks rebuildable via build.sh)
.config/quickshell/android-app/out/
.config/quickshell/android-app/keystore.jks
.config/quickshell/android-app/classes/
# local quickshell runtime log
.config/quickshell/quickshell.log
# compiled local tools (built from ~/projects, not source)
.local/bin/barrage
.local/bin/kyfram
.local/bin/screentime
.local/bin/vex
.local/bin/qemu-launch

# TinyTeX (the whole LaTeX install, ~/.TinyTeX) drops 78 symlinks into
# ~/.local/bin pointing at itself — machine-local, dead on any other machine.
# Listed explicitly: git has no brace expansion, and the folder mixes these
# symlinks with real scripts, so no blanket pattern is safe.
