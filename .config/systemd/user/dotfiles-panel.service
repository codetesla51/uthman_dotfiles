[Unit]
Description=Dotfiles Control Panel
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/home/uthman/dotfiles/panel/panel
WorkingDirectory=/home/uthman/dotfiles/panel
Restart=on-failure
Environment=PORT=8765
Environment=PATH=/home/uthman/.local/bin:/home/uthman/.local/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
